package views

import (
	"fmt"
	db "trabajo-web/db/sqlc"
)

templ EntityList(prendas []db.Prenda) {
	<section class="card-lista">
		<h2>Tu Guardarropa Digital</h2>
		if len(prendas) == 0 {
			<p>No hay prendas registradas aún.</p>
		} else {
			<ul class="lista-container">
				for _, p := range prendas {
					<li class="item-prenda">
						<div class="item-info">
							<strong>{ p.Nombre }</strong>
							<p>Categoría: { p.Categoria }</p>
							<span class="tags">ID Usuario: { fmt.Sprintf("%d", p.UsuarioID) }</span>
						</div>
						<form action="/prendas/eliminar" method="POST" style="margin: 0;">
							<input type="hidden" name="id" value={ fmt.Sprintf("%d", p.ID) }/>
							<input type="hidden" name="usuario_id" value={ fmt.Sprintf("%d", p.UsuarioID) }/>
							<button type="submit" class="btn-eliminar">Eliminar</button>
						</form>
					</li>
				}
			</ul>
		}
	</section>
}
