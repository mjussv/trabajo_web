package views

import (
	"strconv"
	db "trabajo-web/db/sqlc"
)

script pegarImagen(inputID string) {
	const textInput = document.getElementById(inputID);
	const items = (event.clipboardData || window.clipboardData) && (event.clipboardData || window.clipboardData).items;
	if (!items || !textInput) return;
	for (let i = 0; i < items.length; i++) {
		if (items[i].type.indexOf("image") !== -1) {
			event.preventDefault();
			const file = items[i].getAsFile();
			if (!file) return;
			const reader = new FileReader();
			reader.onload = function(ev) {
				const img = new Image();
				img.onload = function() {
					const maxSide = 800;
					let w = img.width;
					let h = img.height;
					if (w > maxSide || h > maxSide) {
						if (w > h) {
							h = Math.round((h * maxSide) / w);
							w = maxSide;
						} else {
							w = Math.round((w * maxSide) / h);
							h = maxSide;
						}
					}
					const canvas = document.createElement("canvas");
					canvas.width = w;
					canvas.height = h;
					canvas.getContext("2d").drawImage(img, 0, 0, w, h);
					textInput.value = canvas.toDataURL("image/jpeg", 0.82);
					textInput.setCustomValidity("");
				};
				img.src = ev.target.result;
			};
			reader.readAsDataURL(file);
			return;
		}
	}
}

templ IndexPage(
	usuario *db.Usuario,
	prendas []db.Prenda,
	looks []db.ListarLooksPorUsuarioRow,
	filtro string,
	errorMsg string,
) {
	@Layout("OOTD 🛍️ - Tu Guardarropa") {
		<h1>OOTD 🛍️</h1>
		<p class="subtitle">Tu guardarropa digital: armá tus outfits e inspirate</p>

		if errorMsg != "" {
			<div class="alert-error">{ errorMsg }</div>
		}

		if usuario == nil {
			<div class="auth-grid">
				<section class="card-form">
					<h2>🔑 Iniciar Sesión</h2>
					<form action="/login" method="POST">
						<input
							type="text"
							name="nombre"
							placeholder="Nombre de usuario"
							oninvalid="this.setCustomValidity('Completá tu nombre de usuario')"
							oninput="this.setCustomValidity('')"
							required
						/>
						<input
							type="password"
							name="password"
							placeholder="Contraseña"
							oninvalid="this.setCustomValidity('Completá tu contraseña')"
							oninput="this.setCustomValidity('')"
							required
						/>
						<button type="submit">Ingresar</button>
					</form>
				</section>

				<section class="card-form">
					<h2>👤 Registrar Nuevo Usuario</h2>
					<form action="/usuarios/crear-web" method="POST">
						<input
							type="text"
							name="nombre"
							placeholder="Tu Nombre de usuario"
							oninvalid="this.setCustomValidity('Completá tu nombre de usuario')"
							oninput="this.setCustomValidity('')"
							required
						/>
						<input
							type="email"
							name="email"
							placeholder="Tu Email (ej: usuario@email.com)"
							pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}"
							title="Ingresá un email válido con dominio (ej: usuario@email.com)"
							oninvalid="this.setCustomValidity(this.validity.valueMissing ? 'Completá tu email' : 'Ingresá un email válido con dominio (ej: usuario@email.com)')"
							oninput="this.setCustomValidity('')"
							required
						/>
						<input
							type="password"
							name="password"
							placeholder="Creá tu contraseña (mín. 6 caracteres)"
							minlength="6"
							title="La contraseña debe tener al menos 6 caracteres"
							oninvalid="this.setCustomValidity(this.validity.valueMissing ? 'Creá una contraseña' : 'La contraseña debe tener al menos 6 caracteres')"
							oninput="this.setCustomValidity('')"
							required
						/>
						<button type="submit">Crear Cuenta</button>
					</form>
				</section>
			</div>
		} else {
			<nav class="navbar">
				<div class="nav-links">
					<a href="/" class="nav-btn active">👤 Mi Perfil</a>
					<a href="/explorar" class="nav-btn">🔍 Explorar Red</a>
				</div>
				<form action="/logout" method="POST">
					<button type="submit" class="btn-logout">Cerrar Sesión</button>
				</form>
			</nav>

			<section class="profile-header">
				<div>
					<span class="badge-role">Mi Perfil</span>
					<h2>{ usuario.Nombre }</h2>
					<p>{ usuario.Email }</p>
				</div>
				<div class="profile-stats">
					<div><strong id="stat-prendas">{ strconv.Itoa(len(prendas)) }</strong><span>Prendas</span></div>
					<div><strong id="stat-looks">{ strconv.Itoa(len(looks)) }</strong><span>Looks</span></div>
				</div>
			</section>

			<div class="forms-grid">
				<section class="card-form">
					<h2>➕ Cargar Nueva Prenda</h2>
					<form
						hx-post="/prendas"
						hx-target="#grid-prendas"
						hx-swap="outerHTML"
						hx-on::after-request="if(event.detail.successful){ this.reset(); document.getElementById('seccion-prendas')?.classList.remove('hidden'); }"
					>
						<input type="text" name="nombre" placeholder="Nombre (ej: Camperón de Cuero)" required/>
						<input type="text" name="categoria" placeholder="Categoría (ej: Abrigos, Calzado, Tops)" required/>
						<div class="input-url-group">
							<input
								id="prenda-url"
								type="text"
								name="url_imagen"
								placeholder="URL de la foto de la prenda (https://...)"
								onpaste={ pegarImagen("prenda-url") }
							/>
							<button
								type="button"
								class="btn-clear-url"
								onclick="const inp = document.getElementById('prenda-url'); inp.value = ''; inp.setCustomValidity(''); inp.focus();"
							>
								Borrar URL
							</button>
						</div>
						<button type="submit">Guardar Prenda</button>
					</form>
				</section>

				<section class="card-form">
					<h2>✨ Crear Nuevo Look</h2>
					<form
						hx-post="/looks"
						hx-target="#grid-looks"
						hx-swap="outerHTML"
						hx-on::after-request="if(event.detail.successful){ this.reset(); document.getElementById('seccion-looks')?.classList.remove('hidden'); }"
					>
						<input type="text" name="nombre" placeholder="Nombre del Look (ej: Urbano Noche)" required/>
						<input type="text" name="descripcion" placeholder="Descripción (notas, tips de combinación)"/>
						<div class="form-row">
							<input type="text" name="ocasion" placeholder="Ocasión (ej: Casual, Fiesta)" required/>
							<input type="text" name="temporada" placeholder="Temporada (ej: Invierno, Verano)" required/>
						</div>
						<div class="form-row">
							<input type="text" name="estilo" placeholder="Estilo (ej: Minimalista, Streetwear)"/>
							@PrendasSelect(prendas, false)
						</div>
						<div class="input-url-group">
							<input
								id="look-url"
								type="text"
								name="url_imagen"
								placeholder="URL de la foto del Look (https://...)"
								onpaste={ pegarImagen("look-url") }
								required
							/>
							<button
								type="button"
								class="btn-clear-url"
								onclick="const inp = document.getElementById('look-url'); inp.value = ''; inp.setCustomValidity(''); inp.focus();"
							>
								Borrar URL
							</button>
						</div>
						<button type="submit">Publicar Look</button>
					</form>
				</section>
			</div>

			<section class="card-lista">
				<div class="guardarropa-header">
					<h2>👗 Guardarropa</h2>
					<div class="filter-pills">
						<a href="/?filtro=todos" class={ "pill", templ.KV("active", filtro == "todos" || filtro == "") }>
							Todos (<span id="count-todos">{ strconv.Itoa(len(prendas) + len(looks)) }</span>)
						</a>
						<a href="/?filtro=prendas" class={ "pill", templ.KV("active", filtro == "prendas") }>
							Prendas (<span id="count-prendas">{ strconv.Itoa(len(prendas)) }</span>)
						</a>
						<a href="/?filtro=looks" class={ "pill", templ.KV("active", filtro == "looks") }>
							Looks (<span id="count-looks">{ strconv.Itoa(len(looks)) }</span>)
						</a>
					</div>
				</div>

				<div id="seccion-looks" class={ templ.KV("hidden", filtro == "prendas") }>
					<h3 class="sub-section-title">Looks guardados</h3>
					@LooksList(looks, false)
				</div>

				<div id="seccion-prendas" class={ templ.KV("hidden", filtro == "looks") } style="margin-top: 24px;">
					<h3 class="sub-section-title">Prendas sueltas</h3>
					@PrendasList(prendas)
				</div>
			</section>
		}
	}
}
