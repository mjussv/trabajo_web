package views

import (
	"strconv"
	db "trabajo-web/db/sqlc"
)

templ IndexPage(
	usuario *db.Usuario,
	prendas []db.Prenda,
	looks []db.ListarLooksPorUsuarioRow,
	filtro string,
	errorMsg string,
) {
	@Layout("OOTD 🛍️ - Tu Guardarropa") {
		<h1>OOTD 🛍️</h1>
		<p class="subtitle">Tu guardarropa digital: armá tus outfits e inspirate</p>

		if errorMsg != "" {
			<div class="alert-error">{ errorMsg }</div>
		}

		if usuario == nil {
			<div class="auth-grid">
				<section class="card-form">
					<h2>🔑 Iniciar Sesión</h2>
					<form action="/login" method="POST">
						<input type="text" name="nombre" placeholder="Nombre de usuario" required/>
						<input type="password" name="password" placeholder="Contraseña" required/>
						<button type="submit">Ingresar</button>
					</form>
				</section>

				<section class="card-form">
					<h2>👤 Registrar Nuevo Usuario</h2>
					<form action="/usuarios/crear-web" method="POST">
						<input type="text" name="nombre" placeholder="Tu Nombre de usuario" required/>
						<input type="email" name="email" placeholder="Tu Email (ej: usuario@email.com)" required/>
						<input type="password" name="password" placeholder="Creá tu contraseña" required/>
						<button type="submit">Crear Cuenta</button>
					</form>
				</section>
			</div>
		} else {
			<nav class="navbar">
				<div class="nav-links">
					<a href="/" class="nav-btn active">👤 Mi Perfil</a>
					<a href="/explorar" class="nav-btn">🔍 Explorar Red</a>
				</div>
				<a href="/logout" class="btn-logout">Cerrar Sesión</a>
			</nav>

			<section class="profile-header">
				<div>
					<span class="badge-role">Mi Perfil</span>
					<h2>{ usuario.Nombre }</h2>
					<p>{ usuario.Email }</p>
				</div>
				<div class="profile-stats">
					<div><strong id="stat-prendas">{ strconv.Itoa(len(prendas)) }</strong><span>Prendas</span></div>
					<div><strong id="stat-looks">{ strconv.Itoa(len(looks)) }</strong><span>Looks</span></div>
				</div>
			</section>

			<div class="forms-grid">
				<section class="card-form">
					<h2>➕ Cargar Nueva Prenda</h2>
					<form
						hx-post="/prendas"
						hx-target="#grid-prendas"
						hx-swap="outerHTML"
						hx-on::after-request="if(event.detail.successful) this.reset()"
					>
						<input type="text" name="nombre" placeholder="Nombre (ej: Camperón de Cuero)" required/>
						<input type="text" name="categoria" placeholder="Categoría (ej: Abrigos, Calzado, Tops)" required/>
						<input type="url" name="url_imagen" placeholder="URL de la foto de la prenda (https://...)"/>
						<button type="submit">Guardar Prenda</button>
					</form>
				</section>

				<section class="card-form">
					<h2>✨ Crear Nuevo Look</h2>
					<form
						hx-post="/looks"
						hx-target="#grid-looks"
						hx-swap="outerHTML"
						hx-on::after-request="if(event.detail.successful) this.reset()"
					>
						<input type="text" name="nombre" placeholder="Nombre del Look (ej: Urbano Noche)" required/>
						<input type="text" name="descripcion" placeholder="Descripción (notas, tips de combinación)"/>
						<div class="form-row">
							<input type="text" name="ocasion" placeholder="Ocasión (ej: Casual, Fiesta)" required/>
							<input type="text" name="temporada" placeholder="Temporada (ej: Invierno, Verano)" required/>
						</div>
						<div class="form-row">
							<input type="text" name="estilo" placeholder="Estilo (ej: Minimalista, Streetwear)"/>
							@PrendasSelect(prendas, false)
						</div>
						<input type="url" name="url_imagen" placeholder="URL de la foto del Look (https://...)" required/>
						<button type="submit">Publicar Look</button>
					</form>
				</section>
			</div>

			<section class="card-lista">
				<div class="guardarropa-header">
					<h2>👗 Guardarropa</h2>
					<div class="filter-pills">
						<a href="/?filtro=todos" class={ "pill", templ.KV("active", filtro == "todos" || filtro == "") }>
							Todos (<span id="count-todos">{ strconv.Itoa(len(prendas) + len(looks)) }</span>)
						</a>
						<a href="/?filtro=prendas" class={ "pill", templ.KV("active", filtro == "prendas") }>
							Prendas (<span id="count-prendas">{ strconv.Itoa(len(prendas)) }</span>)
						</a>
						<a href="/?filtro=looks" class={ "pill", templ.KV("active", filtro == "looks") }>
							Looks (<span id="count-looks">{ strconv.Itoa(len(looks)) }</span>)
						</a>
					</div>
				</div>

				<div class={ templ.KV("hidden", filtro == "prendas") }>
					<h3 class="sub-section-title">Looks guardados</h3>
					@LooksList(looks, false)
				</div>

				<div class={ templ.KV("hidden", filtro == "looks") } style="margin-top: 24px;">
					<h3 class="sub-section-title">Prendas sueltas</h3>
					@PrendasList(prendas)
				</div>
			</section>
		}
	}
}
