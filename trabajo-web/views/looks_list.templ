package views

import (
	"fmt"
	db "trabajo-web/db/sqlc"
)

templ LooksList(looks []db.ListarLooksPorUsuarioRow, oob bool) {
	<div
		class="pinterest-grid"
		id="grid-looks"
		if oob {
			hx-swap-oob="true"
		}
	>
		if len(looks) == 0 {
			<p class="empty-msg">Todavía no armaste ningún look.</p>
		} else {
			for _, l := range looks {
				<article class="pin-card">
					@ImagenCard(l.UrlImagen, l.Nombre)
					<div class="pin-body">
						<div class="pin-tags">
							<span class="tag">{ l.Ocasion }</span>
							<span class="tag">{ l.Temporada }</span>
							if l.Estilo.Valid && l.Estilo.String != "" {
								<span class="tag tag-accent">{ l.Estilo.String }</span>
							}
						</div>
						<h4>{ l.Nombre }</h4>
						if l.Descripcion.Valid && l.Descripcion.String != "" {
							<p class="pin-desc">{ l.Descripcion.String }</p>
						}
						if l.PrendaEstrella.Valid && l.PrendaEstrella.String != "" {
							<p class="pin-star">⭐ Prenda estrella: <strong>{ l.PrendaEstrella.String }</strong></p>
						}
						<div class="pin-footer">
							<span class="likes-badge">❤️ { fmt.Sprintf("%d", l.TotalMeGusta) }</span>
							<button
								type="button"
								hx-delete={ fmt.Sprintf("/looks/%d", l.ID) }
								hx-target="#grid-looks"
								hx-swap="outerHTML"
								hx-confirm="¿Seguro que querés borrar este look?"
								class="btn-eliminar"
							>
								Borrar
							</button>
						</div>
					</div>
				</article>
			}
		}
	</div>
}
