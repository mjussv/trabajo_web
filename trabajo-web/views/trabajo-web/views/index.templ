package views

import (
	"fmt"
	"strconv"
	db "trabajo-web/db/sqlc"
)

templ IndexPage(
	usuario *db.Usuario,
	prendas []db.Prenda,
	looks []db.ListarLooksPorUsuarioRow,
	filtro string,
	errorMsg string,
) {
	@Layout("OOTD 🛍️ - Tu Guardarropa") {
		<h1>OOTD 🛍️</h1>
		<p class="subtitle">Tu guardarropa digital: armá tus outfits e inspirate</p>

		if errorMsg != "" {
			<div class="alert-error">{ errorMsg }</div>
		}

		if usuario == nil {
			<!-- PANTALLA 1: INICIO DE SESIÓN Y REGISTRO -->
			<div class="auth-grid">
				<section class="card-form">
					<h2>🔑 Iniciar Sesión</h2>
					<form action="/login" method="POST">
						<input type="text" name="nombre" placeholder="Nombre de usuario" required/>
						<input type="password" name="password" placeholder="Contraseña" required/>
						<button type="submit">Ingresar</button>
					</form>
				</section>

				<section class="card-form">
					<h2>👤 Registrar Nuevo Usuario</h2>
					<form action="/usuarios/crear-web" method="POST">
						<input type="text" name="nombre" placeholder="Tu Nombre de usuario" required/>
						<input type="email" name="email" placeholder="Tu Email (ej: usuario@email.com)" required/>
						<input type="password" name="password" placeholder="Creá tu contraseña" required/>
						<button type="submit">Crear Cuenta</button>
					</form>
				</section>
			</div>
		} else {
			<!-- BARRA DE NAVEGACIÓN SUPERIOR -->
			<nav class="navbar">
				<div class="nav-links">
					<a href="/" class="nav-btn active">👤 Mi Perfil</a>
					<a href="/explorar" class="nav-btn">🔍 Explorar Red</a>
				</div>
				<a href="/logout" class="btn-logout">Cerrar Sesión</a>
			</nav>

			<!-- CABECERA DEL PERFIL -->
			<section class="profile-header">
				<div>
					<span class="badge-role">Mi Perfil</span>
					<h2>{ usuario.Nombre }</h2>
					<p>{ usuario.Email }</p>
				</div>
				<div class="profile-stats">
					<div><strong>{ strconv.Itoa(len(prendas)) }</strong><span>Prendas</span></div>
					<div><strong>{ strconv.Itoa(len(looks)) }</strong><span>Looks</span></div>
				</div>
			</section>

			<!-- FORMULARIOS DE CREACIÓN (UNO ABAJO DEL OTRO) -->
			<div class="forms-grid">
				<section class="card-form">
					<h2>➕ Cargar Nueva Prenda</h2>
					<form action="/prendas" method="POST">
						<input type="text" name="nombre" placeholder="Nombre (ej: Camperón de Cuero)" required/>
						<input type="text" name="categoria" placeholder="Categoría (ej: Abrigos, Calzado, Tops)" required/>
						<input type="url" name="url_imagen" placeholder="URL de la foto de la prenda (https://...)"/>
						<button type="submit">Guardar Prenda</button>
					</form>
				</section>

				<section class="card-form">
					<h2>✨ Crear Nuevo Look</h2>
					<form action="/looks/crear-web" method="POST">
						<input type="text" name="nombre" placeholder="Nombre del Look (ej: Urbano Noche)" required/>
						<input type="text" name="descripcion" placeholder="Descripción (notas, tips de combinación)"/>
						<div class="form-row">
							<input type="text" name="ocasion" placeholder="Ocasión (ej: Casual, Fiesta)" required/>
							<input type="text" name="temporada" placeholder="Temporada (ej: Invierno, Verano)" required/>
						</div>
						<div class="form-row">
							<input type="text" name="estilo" placeholder="Estilo (ej: Minimalista, Streetwear)"/>
							<select name="prenda_estrella_id">
								<option value="">-- Prenda estrella (opcional) --</option>
								for _, p := range prendas {
									<option value={ strconv.Itoa(int(p.ID)) }>{ p.Nombre } ({ p.Categoria })</option>
								}
							</select>
						</div>
						<input type="url" name="url_imagen" placeholder="URL de la foto del Look (https://...)" required/>
						<button type="submit">Publicar Look</button>
					</form>
				</section>
			</div>

			<!-- GUARDARROPA CON FILTROS -->
			<section class="card-lista">
				<div class="guardarropa-header">
					<h2>👗 Guardarropa</h2>
					<div class="filter-pills">
						<a href="/?filtro=todos" class={ "pill", templ.KV("active", filtro == "todos" || filtro == "") }>
							Todos ({ strconv.Itoa(len(prendas) + len(looks)) })
						</a>
						<a href="/?filtro=prendas" class={ "pill", templ.KV("active", filtro == "prendas") }>
							Prendas ({ strconv.Itoa(len(prendas)) })
						</a>
						<a href="/?filtro=looks" class={ "pill", templ.KV("active", filtro == "looks") }>
							Looks ({ strconv.Itoa(len(looks)) })
						</a>
					</div>
				</div>

				if filtro == "todos" || filtro == "" || filtro == "looks" {
					<h3 class="sub-section-title">Looks guardados</h3>
					if len(looks) == 0 {
						<p class="empty-msg">Todavía no armaste ningún look.</p>
					} else {
						<div class="pinterest-grid">
							for _, l := range looks {
								<article class="pin-card">
									<img src={ l.UrlImagen } alt={ l.Nombre } class="pin-img"/>
									<div class="pin-body">
										<div class="pin-tags">
											<span class="tag">{ l.Ocasion }</span>
											<span class="tag">{ l.Temporada }</span>
											if l.Estilo.Valid && l.Estilo.String != "" {
												<span class="tag tag-accent">{ l.Estilo.String }</span>
											}
										</div>
										<h4>{ l.Nombre }</h4>
										if l.Descripcion.Valid && l.Descripcion.String != "" {
											<p class="pin-desc">{ l.Descripcion.String }</p>
										}
										if l.PrendaEstrella.Valid && l.PrendaEstrella.String != "" {
											<p class="pin-star">⭐ Prenda estrella: <strong>{ l.PrendaEstrella.String }</strong></p>
										}
										<div class="pin-footer">
											<span class="likes-badge">❤️ { fmt.Sprintf("%d", l.TotalMeGusta) }</span>
											<form action="/looks/eliminar-web" method="POST" style="margin:0;">
												<input type="hidden" name="id" value={ fmt.Sprintf("%d", l.ID) }/>
												<button type="submit" class="btn-eliminar">Borrar</button>
											</form>
										</div>
									</div>
								</article>
							}
						</div>
					}
				}

				if filtro == "todos" || filtro == "" || filtro == "prendas" {
					<h3 class="sub-section-title" style="margin-top: 24px;">Prendas sueltas</h3>
					if len(prendas) == 0 {
						<p class="empty-msg">No tenés prendas cargadas en tu clóset aún.</p>
					} else {
						<div class="pinterest-grid">
							for _, p := range prendas {
								<article class="pin-card">
									<img src={ p.UrlImagen } alt={ p.Nombre } class="pin-img"/>
									<div class="pin-body">
										<span class="tag">{ p.Categoria }</span>
										<h4>{ p.Nombre }</h4>
										<div class="pin-footer">
											<span class="tags">ID: { fmt.Sprintf("%d", p.ID) }</span>
											<form action="/prendas/eliminar" method="POST" style="margin:0;">
												<input type="hidden" name="id" value={ fmt.Sprintf("%d", p.ID) }/>
												<button type="submit" class="btn-eliminar">Borrar</button>
											</form>
										</div>
									</div>
								</article>
							}
						</div>
					}
				}
			</section>
		}
	}
}
